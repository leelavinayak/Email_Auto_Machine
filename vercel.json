{
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "npm run install-all",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index/:path*"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "server/uploads/**"
    }
  }
}