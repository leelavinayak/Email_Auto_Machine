# Server port
PORT=5000

# MongoDB connection URI (uses built-in memory store if not reachable)
MONGO_URI=mongodb://127.0.0.1:27017/vemu

# Secret used to sign login tokens (change in production!)
JWT_SECRET=change-me-to-a-long-random-string

# System SMTP used for transactional emails (e.g. password reset OTP).
# If set, reset codes are delivered directly to the registered inbox.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_SECURE=false
# SMTP_FROM_NAME=Email Auto Machine
# SMTP_FROM_EMAIL=you@gmail.com

# Public app URL used in email CTA buttons (e.g. welcome email "Start your campaign").
# APP_URL=http://localhost:5173